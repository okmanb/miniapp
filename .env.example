# --- Supabase ---
# Sacalos de: Project Settings > API Keys en supabase.com
# La anon key es publica por diseno: lo que protege los datos es RLS, que esta
# activo en todas las tablas.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo para tareas de servidor (jobs, importaciones). Nunca en el browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# El client id de la consola de Google (Clients > Web application).
# Es un dato publico: viaja en la URL de cada login de OAuth. Sin el, el
# ingreso con Google cae al camino largo, el que pasa por la pantalla de
# Supabase y muestra el id del proyecto.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
