# --- Supabase ---
# Sacalos de: Project Settings > API Keys en supabase.com
# La anon key es publica por diseno: lo que protege los datos es RLS, que esta
# activo en las diez tablas.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo para tareas de servidor (jobs, importaciones). Nunca en el browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
